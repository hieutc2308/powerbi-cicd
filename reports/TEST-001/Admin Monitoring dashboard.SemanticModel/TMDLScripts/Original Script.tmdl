		measure 'View chart - Label' = ```
				
				VAR view_rank =
				    RANKX(
				        ALLSELECTED('FactActivity_Events'[workspace_name]),
				        [Total views]
				    )
				VAR total_view =
				    IF(
				        [Total views] <= 1,
				        [Total views] & " view",
				        [Total views] & " views"
				    )
				RETURN
				    "# " & view_rank 
				    & " | " 
				    & total_view
				    & " | Last view " 
				    & [Last View - Label]
				    
				```
			displayFolder: 1. Overview\View chart
			lineageTag: 77d23ed7-e06e-4aa8-abe8-1bad017228d0

		measure 'Last View - Label' = ```
				
				VAR lastview =
				    CALCULATE(
				        MAX('FactActivity_Events'[creation_time]),
				        'FactActivity_Events'[operation] = "ViewReport"
				    )
				VAR days =
				    DATEDIFF(lastview, TODAY(), DAY)
				RETURN
				SWITCH(TRUE(),
				    days = 0, "Today",
				    days = 1, days & " day ago",
				    days & " days ago"
				)
				    
				```
			displayFolder: 3. Workspaces\CF
			lineageTag: 4bd2ff6d-c1aa-43fa-8ac6-38eb9cb0d721

