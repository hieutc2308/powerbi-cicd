model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Measure","Last Refresh","FactActivity_Events","DimRefreshables","activity_event_synthetic","data_refreshes_synthetic"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DaxQueryView_Desktop","TMDLView_Desktop","DevMode"]

ref table Measure
ref table 'Manual - Service Principal'
ref table 'Last Refresh'
ref table DimCalendar
ref table 'Manual - Active threshold'
ref table 'Manual - Labels'
ref table FactActivity_Events
ref table DimRefreshables

ref cultureInfo en-US

