	hierarchy 'Year Hierarchy'
		lineageTag: 2ea0dd31-14b7-455e-a66f-eb964570f9fe

		level Year
			lineageTag: 92a0d079-fae5-4036-ad51-7942f8f97788
			column: Year

		level Month
			lineageTag: 9aa27dab-06b2-43d8-a0f4-36dded5adc36
			column: Month

		level DateNum
			lineageTag: b6097023-1236-467d-a26d-8b1e65b147d7
			column: DateNum

	partition DimCalendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(MIN(FactActivity_Events[Date]), MAX(FactActivity_Events[Date])),
				    "Year", YEAR([Date]),
				    "MonthNo", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "DateNum", DAY( [Date] )
				)

	annotation PBI_Id = 8944f7bcc5e54c03ab34ff1ca9eaf955

