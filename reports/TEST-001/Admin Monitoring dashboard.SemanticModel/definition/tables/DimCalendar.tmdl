	column Date
		isKey
		formatString: mm/dd/yyyy
		lineageTag: fa62c199-4f38-4567-90d3-c7c8737ad4d7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column Year
		isHidden
		formatString: 0
		lineageTag: 912729ff-8057-4d05-b04a-7ad30a3cdd39
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column MonthNo
		isHidden
		formatString: 0
		lineageTag: 24e05c33-7f8f-4d56-9034-5249a3472309
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthNo]

		annotation SummarizationSetBy = Automatic

	column Month
		isHidden
		lineageTag: 2c3001da-6616-4ba4-b8a6-9245406a1860
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: MonthNo

