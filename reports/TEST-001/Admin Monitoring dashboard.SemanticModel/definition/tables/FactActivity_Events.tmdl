		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'First Recorded' =
			
			CALCULATE(
			    FIRSTDATE('FactActivity_Events'[Date]),
			    FILTER(
			        'FactActivity_Events',
			        'FactActivity_Events'[workspace_id] = EARLIER('FactActivity_Events'[workspace_id])
			        && 'FactActivity_Events'[item_name] = EARLIER('FactActivity_Events'[item_name])
			    )
			)
		formatString: m/d/yyyy
		displayFolder: Calculated Columns
		lineageTag: 34c02fbc-5628-4954-99b0-582241885d9c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'User UPN' =
			
			VAR sp = RELATED('Manual - Service Principal'[Service Principal Name])
			VAR result =
			    IF( ISBLANK(sp),
			        'FactActivity_Events'[user_id],
			        sp
			    )
			
			RETURN
			    result
		displayFolder: Calculated Columns
		lineageTag: 9f521822-8da8-4694-81d4-4ae129c93632
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

