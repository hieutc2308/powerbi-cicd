		lineageTag: 846926b6-37f5-448b-89bf-d52f99dd1d4a

	/// Returns the text 'Refreshes' if the selected operation is a refresh, used to map drill-through actions.
	measure 'Drill - Refresh' = ```
			// Drill through Total refresh
			VAR metric = MAX('FactActivity_Events'[operation])
			
			RETURN 
			SWITCH(
				TRUE, 
				metric = "RefreshDataset",
				"Refreshes"
			)
			```
		displayFolder: Measures Mapping
		lineageTag: 48ad0da7-b5dd-448d-b679-f2c316b2583d

	/// Dynamically returns a metric (e.g., Total Views, Total Refreshes) based on the user's selection from a slicer.
	measure 'Labels Mapping' = ```
			// To map metrics labels with respective groups/axis
				SWITCH( 
					SELECTEDVALUE('Manual - Labels'[Value]),
					
					"Views", [Total views],
					"Refreshes", [Total refreshes],
					"Exports", [Total exports],
					"Import", [ADO Deployment - Total]
				)
			```
		formatString: 0
		displayFolder: Measures Mapping
		lineageTag: b225577c-58f2-47cb-bdad-7bdc48a06946

	/// Returns the text 'Import' if the selected operation is a deployment, used to map drill-through actions.
	measure 'Drill - Deployment' = ```
			// Drill through Total deploy
			VAR metric = MAX('FactActivity_Events'[operation])
			VAR service = MAX(FactActivity_Events[User UPN])
			
			RETURN 
				SWITCH(
					TRUE,
					metric = "Import" && service = "pbi_deployments",
					"Import"
				)
			```
		displayFolder: Measures Mapping
		lineageTag: f75b5e91-18dd-407a-8c19-9998a937ee9a

	/// Provides a specific color code for conditional formatting based on the selected activity type.
	measure 'Activities - CF' = ```
			
			VAR sel = SELECTEDVALUE('Manual - Labels'[Value])
			VAR result =
				SWITCH(
					sel,
					"Views", "#6ABAF9",
					"Refreshes", "#F7B071",
					"Exports", "#F183B2"
				)
			RETURN
			result
			
			```
		displayFolder: 2. Analysis
		lineageTag: 6475016c-2445-4c93-b5d4-682424d66aac

	/// Calculates a negative value based on the maximum user count, used for positioning labels on a chart.
	measure 'Total Users - Negative Label' =
			
			VAR mostuser = MAXX(
				ALL('DimCalendar'[Date]),
				[Total users]
			)
			RETURN
				- (mostuser/2)
		formatString: 0
		displayFolder: 2. Analysis
		lineageTag: 494c43e2-6ac3-427b-b53b-c9572ce02f0d

	/// Creates a display label for deployments, indicating the number of items deployed.
	measure 'ADO Deployment - Label' =
			
			"Deployed: " & [ADO Deployment - Total] & " item(s)"
		displayFolder: 1. Overview\ADO deployment line chart
		lineageTag: 793a91b5-a369-47ce-acce-a624dec4cd39

	partition Measure = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
					#"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
					#"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
					#"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

