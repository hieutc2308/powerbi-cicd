	/// A dummy measure to setup the lower bound of error bar
	measure Baseline = 0
		formatString: 0
		displayFolder: Dummy
		lineageTag: d35e830c-02b2-4aee-9034-02afc0159814

	/// Counts the number of distinct users with activity in the last N days, where N is defined by a slicer.
	measure 'Active Users' = ```
			
			VAR range = 'Manual - Active threshold'[LastNdays]
			VAR cutoff_date = UTCTODAY() - range
			
			VAR result = 
				CALCULATE(
					DISTINCTCOUNT(FactActivity_Events[user_id]),
					FILTER(
						FactActivity_Events,
						'FactActivity_Events'[creation_time] >= cutoff_date
							&& NOT ISBLANK('FactActivity_Events'[creation_time])
					)
				)
			RETURN
				result
			```
		formatString: 0
		displayFolder: 1. Overview\KPI cards
		lineageTag: 208e34df-c2eb-477c-ab70-94e7159d791a

	/// Returns the latest date present in the activity log, indicating the last data refresh.
	measure 'Model Refresh' = MAXX(ALL(FactActivity_Events),FactActivity_Events[Date])
		formatString: General Date
		lineageTag: 6d48869c-1309-4dd6-8fde-c05541ed001e

	/// Calculates the total number of recorded activities (rows) in the activity log.
	measure 'Total activities' = ```
			
				COALESCE(
					COUNTROWS('FactActivity_Events'),
					0)
			```
		formatString: #,0
		displayFolder: Metrics
		lineageTag: e2387b4f-da0e-4d3a-a8d4-ac37e2459e00

