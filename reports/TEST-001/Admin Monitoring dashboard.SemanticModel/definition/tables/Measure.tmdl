	/// Ranks deployments chronologically to create a baseline for a timeline visual.
	measure 'ADO Deployment - Baseline' = ```
			
			VAR ado =
				FILTER(
					ALL('FactActivity_Events'),
					'FactActivity_Events'[operation] = "Import"
						&& 'FactActivity_Events'[User UPN] = "pbi_deployments"
				)
			VAR deploy_rank =
				RANKX(
					ado,
					CALCULATE( MIN( 'DimCalendar'[Date] ) ),, 
					ASC, Dense
				)
			RETURN
				IF(
					NOT ISBLANK([ADO Deployment - Total]),
					deploy_rank
				)
			```
		formatString: 0
		displayFolder: 1. Overview\ADO deployment line chart
		lineageTag: ce0c7530-fe2c-4c53-90fe-f32126801d4b

