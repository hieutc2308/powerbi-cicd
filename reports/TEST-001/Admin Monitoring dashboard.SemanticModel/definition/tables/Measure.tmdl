	/// A flag (1 or 0) to determine if the selected item in a visual can be used for drill-through.
	measure 'Is Drillable' =
			
			VAR totalExport = [Drill - Export]
			VAR totalView = [Drill - View]
			VAR totalRefresh = [Drill - Refresh]
			VAR totalDeploy = [Drill - Deployment]
			
			RETURN
			IF(
				SELECTEDVALUE('Manual - Labels'[Value]) = totalExport
				|| SELECTEDVALUE('Manual - Labels'[Value]) = totalView
				|| SELECTEDVALUE('Manual - Labels'[Value]) = totalRefresh
				|| SELECTEDVALUE('Manual - Labels'[Value]) = totalDeploy,
				1,
				0
			)
		formatString: 0
		displayFolder: Measures Mapping
		lineageTag: 88778af7-1f90-4da1-8adb-642ad1fc9003

	/// Returns the text 'Exports' if the selected operation is an export, used to map drill-through actions.
	measure 'Drill - Export' = ```
