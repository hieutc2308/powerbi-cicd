	partition Dates = calculated
		mode: import
		source = ```
				
				 VAR _MinYear = YEAR(MIN(Sales[DateKey]))
				RETURN
				ADDCOLUMNS(
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Quarter", "Q"&QUARTER([Date]),
				    "QuarterNo", QUARTER([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "MonthNo", MONTH([Date]),
				    "Week", FORMAT([Date], "WWW"),
				    "WeekNo", WEEKNUM([Date]),
				    "WeekID", WEEKNUM([Date], 1) + (YEAR([Date]) - _MinYear) * 53,
				    "Day", FORMAT([Date], "DDD"),
				    "DayNo", DAY([Date])
				)
				```

	annotation PBI_Id = 31f4952387194566999fb6be345e44f4

