table 'Data cost 5M 22'
	lineageTag: 5cc1f115-08f1-4471-af79-0311a50f5f0a

	measure 'Total cost' = ABS(SUM('Data cost 5M 22'[AMOUNT_LCY]))/1000000000
		formatString: 0
		lineageTag: 76ebd77b-4b68-4e57-b786-49665cdb0366

	measure 'Highest Cost Division' =
			
			SELECTCOLUMNS(
			    TOPN(1, ALL('Data cost 5M 22'[Division]), [Total cost], DESC),
			    "DivisionName", 'Data cost 5M 22'[Division]
			)
		lineageTag: 45b6411e-a338-4a9c-8aca-417e456cfcaf

	measure 'Highest Cost Item' =
			
			SELECTCOLUMNS(
			    TOPN(1, ALL('Data cost 5M 22'[Cost item]), [Total cost], DESC),
			    "ItemName", 'Data cost 5M 22'[Cost item]
			)
		lineageTag: a2c27610-2b21-4c00-8fc0-06739a4c61bb

	measure 'Highest Cost Month' =
			
			SELECTCOLUMNS(
			    TOPN(1, ALL('Data cost 5M 22'[Month Date]), [Total cost], DESC),
			    "MonthName", FORMAT('Data cost 5M 22'[Month Date], "MMMM")
			)
		lineageTag: 04294325-f2da-4db0-b20d-ab0c08471ea9

	measure 'Average Cost Per Employee' = ('Data cost 5M 22'[Total cost]/'Data HC May 22'[Total Head Count])*1000
		lineageTag: ea57fc0a-3e97-4e2d-9f9c-d35f6cb99ca9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salary Cost' =
			
			CALCULATE(
			    ABS(SUM('Data cost 5M 22'[AMOUNT_LCY])) / 1000000000,
			    'Data cost 5M 22'[Cost item] = "Salary"
			)
		lineageTag: 535daac8-4488-4910-83ce-d77eb52feb79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

